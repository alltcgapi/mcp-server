{
  "name": "alltcgapi",
  "version": "0.1.1",
  "description": "Trading card data for agents: cards, sets, sealed products and current Cardmarket (EUR) and TCGplayer (USD) quotes across 19 games, each with its source and date.",
  "author": {
    "name": "alltcgapi.com",
    "url": "https://alltcgapi.com"
  },
  "homepage": "https://alltcgapi.com/docs",
  "repository": "https://github.com/alltcgapi/mcp-server",
  "license": "MIT",
  "keywords": ["tcg", "trading-card-game", "card-prices", "cardmarket", "tcgplayer", "mcp"],
  "documentationUrl": "https://alltcgapi.com/docs",
  "supportUrl": "https://github.com/alltcgapi/mcp-server/issues",
  "privacyPolicyUrl": "https://alltcgapi.com/legal/privacy",
  "termsOfServiceUrl": "https://alltcgapi.com/legal/terms",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "alltcgapi.com API key",
      "description": "Sent only to api.alltcgapi.com. How to get one: https://alltcgapi.com/free-api-key",
      "sensitive": true
    }
  },
  "mcpServers": {
    "alltcgapi": {
      "command": "npx",
      "args": ["-y", "@alltcgapi/mcp@0.1.1"],
      "env": {
        "ALLTCG_API_KEY": "${user_config.api_key}"
      }
    }
  }
}
